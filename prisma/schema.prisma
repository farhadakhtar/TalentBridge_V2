generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles: "job_seeker" | "recruiter" | "company"
// subRole (company only): "cyber" | "engineer" | "ceo"
// status (job seekers): "Applied" | "Interview" | "Offer"
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String
  title     String?
  skills    String? // JSON array string
  status    String?
  subRole   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations  Conversation[]
  messagesSent   Message[]
  eventsCreated  CalendarEvent[] @relation("EventCreator")
  eventsTargeted CalendarEvent[] @relation("EventTarget")
  notifications  Notification[]
  auditLogs      AuditLog[]
  jobsPosted     Job[]
  applications   Application[]
}

model Conversation {
  id            String   @id @default(cuid())
  participants  User[] // exactly 2 users (implicit many-to-many)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// type: "Interview" | "Meeting" | "Call"
// date stored as "YYYY-MM-DD", time as "HH:mm" (24h)
model CalendarEvent {
  id           String   @id @default(cuid())
  title        String
  date         String
  time         String
  type         String
  notes        String?
  creator      User     @relation("EventCreator", fields: [createdById], references: [id])
  createdById  String
  targetUser   User     @relation("EventTarget", fields: [targetUserId], references: [id])
  targetUserId String
  createdAt    DateTime @default(now())
}

// type: "dm" | "event" — refId = conversationId or eventId
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  refId     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  createdAt DateTime @default(now())
}

// Job postings published by recruiters.
// type: "Full-time" | "Part-time" | "Internship" | "Contract"
// skills stored as JSON array string, e.g. ["React","TypeScript"]
model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  type        String
  description String
  skills      String // JSON array string
  postedBy    User     @relation(fields: [postedById], references: [id])
  postedById  String
  createdAt   DateTime @default(now())

  applications Application[]
}

// Job applications submitted by job seekers.
// status: "Applied" | "Interview" | "Offer" | "Rejected" (defaults to "Applied")
// One application per (job, user) — enforced by @@unique.
model Application {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  coverLetter String?
  status      String   @default("Applied")
  createdAt   DateTime @default(now())

  @@unique([jobId, userId])
}
